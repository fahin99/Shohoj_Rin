generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId        String   @id @default(uuid()) @map("user_id") @db.Uuid
  email         String   @unique @db.VarChar(255)
  phone         String?  @unique @db.VarChar(20)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  role          String   @default("borrower") @db.VarChar(20)
  accountStatus String   @default("active") @map("account_status") @db.VarChar(20)
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  profile              UserProfile?
  loginSessions        LoginSession[]
  verificationRequests VerificationRequest[] @relation("UserVerifications")
  reviewedRequests     VerificationRequest[] @relation("ReviewerVerifications")
  guarantors           Guarantor[]
  trustScores          TrustScore[]
  loanApplications     LoanApplication[]
  loans                Loan[]
  fraudFlags           FraudFlag[]           @relation("UserFraudFlags")
  reviewedFraudFlags   FraudFlag[]           @relation("ReviewerFraudFlags")
  auditLogs            AuditLog[]
  notifications        Notification[]
  partnerDecisions     PartnerDecision[]

  @@map("users")
}

model LoginSession {
  sessionId        String   @id @default(uuid()) @map("session_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  ipAddress        String?  @map("ip_address") @db.Inet
  userAgent        String?  @map("user_agent")
  isRevoked        Boolean  @default(false) @map("is_revoked")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz()
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [userId])

  @@map("login_sessions")
}

model Institution {
  institutionId String   @id @default(uuid()) @map("institution_id") @db.Uuid
  name          String   @unique @db.VarChar(255)
  type          String   @db.VarChar(50)
  address       String?
  isVerified    Boolean  @default(false) @map("is_verified")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  profiles UserProfile[]

  @@map("institutions")
}

model UserProfile {
  profileId          String   @id @default(uuid()) @map("profile_id") @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  fullName           String   @map("full_name") @db.VarChar(255)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             String?  @db.VarChar(20)
  nidNumber          String?  @unique @map("nid_number") @db.VarChar(50)
  addressLine        String?  @map("address_line")
  city               String?  @db.VarChar(100)
  district           String?  @db.VarChar(100)
  postalCode         String?  @map("postal_code") @db.VarChar(20)
  occupation         String?  @db.VarChar(100)
  monthlyFamilyIncome Decimal? @map("monthly_family_income") @db.Decimal(12, 2)
  institutionId      String?  @map("institution_id") @db.Uuid
  studentId          String?  @map("student_id") @db.VarChar(100)
  enrollmentYear     Int?     @map("enrollment_year")
  profilePhotoUrl    String?  @map("profile_photo_url")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user        User         @relation(fields: [userId], references: [userId])
  institution Institution?  @relation(fields: [institutionId], references: [institutionId])

  @@map("user_profiles")
}

model VerificationRequest {
  requestId        String    @id @default(uuid()) @map("request_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  verificationType String    @map("verification_type") @db.VarChar(50)
  status           String    @default("pending") @db.VarChar(20)
  reviewerId       String?   @map("reviewer_id") @db.Uuid
  reviewerNotes    String?   @map("reviewer_notes")
  submittedAt      DateTime  @default(now()) @map("submitted_at") @db.Timestamptz()
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz()

  user      User                   @relation("UserVerifications", fields: [userId], references: [userId])
  reviewer  User?                  @relation("ReviewerVerifications", fields: [reviewerId], references: [userId])
  documents VerificationDocument[]

  @@map("verification_requests")
}

model VerificationDocument {
  documentId   String   @id @default(uuid()) @map("document_id") @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  documentType String   @map("document_type") @db.VarChar(50)
  fileUrl      String   @map("file_url")
  fileName     String?  @map("file_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()

  request VerificationRequest @relation(fields: [requestId], references: [requestId])

  @@map("verification_documents")
}

model Guarantor {
  guarantorId  String   @id @default(uuid()) @map("guarantor_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(255)
  relationship String   @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  email        String?  @db.VarChar(255)
  nidNumber    String?  @map("nid_number") @db.VarChar(50)
  address      String?
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [userId])

  @@map("guarantors")
}

model TrustScore {
  scoreId      String   @id @default(uuid()) @map("score_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  score        Decimal  @db.Decimal(5, 2)
  trustBand    String   @map("trust_band") @db.VarChar(10)
  triggerEvent String   @map("trigger_event") @db.VarChar(100)
  isCurrent    Boolean  @default(true) @map("is_current")
  calculatedAt DateTime @default(now()) @map("calculated_at") @db.Timestamptz()

  user    User              @relation(fields: [userId], references: [userId])
  factors TrustScoreFactor[]
  loanApplications LoanApplication[]

  @@map("trust_scores")
}

model TrustScoreFactor {
  factorId    String  @id @default(uuid()) @map("factor_id") @db.Uuid
  scoreId     String  @map("score_id") @db.Uuid
  factorName  String  @map("factor_name") @db.VarChar(100)
  factorValue Decimal @map("factor_value") @db.Decimal(6, 2)
  description String?

  score TrustScore @relation(fields: [scoreId], references: [scoreId])

  @@map("trust_score_factors")
}

model FundingPartner {
  partnerId    String   @id @default(uuid()) @map("partner_id") @db.Uuid
  name         String   @unique @db.VarChar(255)
  type         String   @db.VarChar(50)
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  contactPhone String?  @map("contact_phone") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  rules            PartnerRule[]
  loanApplications LoanApplication[]
  loanOffers       LoanOffer[]
  loans            Loan[]
  decisions        PartnerDecision[]

  @@map("funding_partners")
}

model PartnerRule {
  ruleId           String    @id @default(uuid()) @map("rule_id") @db.Uuid
  partnerId        String    @map("partner_id") @db.Uuid
  minTrustScore    Decimal?  @map("min_trust_score") @db.Decimal(5, 2)
  maxLoanAmount    Decimal?  @map("max_loan_amount") @db.Decimal(12, 2)
  maxTenureMonths  Int?      @map("max_tenure_months")
  eligiblePurposes String?   @map("eligible_purposes")
  isActive         Boolean   @default(true) @map("is_active")
  effectiveFrom    DateTime  @default(now()) @map("effective_from") @db.Timestamptz()
  effectiveUntil   DateTime? @map("effective_until") @db.Timestamptz()
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  partner FundingPartner @relation(fields: [partnerId], references: [partnerId])

  @@map("partner_rules")
}

model LoanApplication {
  applicationId      String    @id @default(uuid()) @map("application_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  partnerId          String?   @map("partner_id") @db.Uuid
  requestedAmount    Decimal   @map("requested_amount") @db.Decimal(12, 2)
  purpose            String    @db.VarChar(100)
  purposeDescription String?   @map("purpose_description")
  status             String    @default("draft") @db.VarChar(20)
  trustScoreId       String?   @map("trust_score_id") @db.Uuid
  submittedAt        DateTime? @map("submitted_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user       User            @relation(fields: [userId], references: [userId])
  partner    FundingPartner?  @relation(fields: [partnerId], references: [partnerId])
  trustScore TrustScore?      @relation(fields: [trustScoreId], references: [scoreId])
  offer      LoanOffer?
  loan       Loan?
  decisions  PartnerDecision[]

  @@map("loan_applications")
}

model LoanOffer {
  offerId       String    @id @default(uuid()) @map("offer_id") @db.Uuid
  applicationId String    @unique @map("application_id") @db.Uuid
  partnerId     String    @map("partner_id") @db.Uuid
  offeredAmount Decimal   @map("offered_amount") @db.Decimal(12, 2)
  interestRate  Decimal   @map("interest_rate") @db.Decimal(5, 2)
  tenureMonths  Int       @map("tenure_months")
  conditions    String?
  status        String    @default("pending") @db.VarChar(20)
  offeredAt     DateTime  @default(now()) @map("offered_at") @db.Timestamptz()
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz()
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz()

  application LoanApplication @relation(fields: [applicationId], references: [applicationId])
  partner     FundingPartner  @relation(fields: [partnerId], references: [partnerId])
  loan        Loan?

  @@map("loan_offers")
}

model Loan {
  loanId          String   @id @default(uuid()) @map("loan_id") @db.Uuid
  applicationId   String   @unique @map("application_id") @db.Uuid
  offerId         String   @unique @map("offer_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  partnerId       String   @map("partner_id") @db.Uuid
  principalAmount Decimal  @map("principal_amount") @db.Decimal(12, 2)
  interestRate    Decimal  @map("interest_rate") @db.Decimal(5, 2)
  tenureMonths    Int      @map("tenure_months")
  status          String   @default("active") @db.VarChar(20)
  startDate       DateTime @map("start_date") @db.Date
  expectedEndDate DateTime @map("expected_end_date") @db.Date
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  application        LoanApplication     @relation(fields: [applicationId], references: [applicationId])
  offer              LoanOffer           @relation(fields: [offerId], references: [offerId])
  user               User                @relation(fields: [userId], references: [userId])
  partner            FundingPartner      @relation(fields: [partnerId], references: [partnerId])
  disbursements      LoanDisbursement[]
  repaymentSchedules RepaymentSchedule[]

  @@map("loans")
}

model LoanDisbursement {
  disbursementId     String   @id @default(uuid()) @map("disbursement_id") @db.Uuid
  loanId             String   @map("loan_id") @db.Uuid
  amount             Decimal  @db.Decimal(12, 2)
  disbursementMethod String?  @map("disbursement_method") @db.VarChar(50)
  referenceNumber    String?  @map("reference_number") @db.VarChar(100)
  disbursedAt        DateTime @default(now()) @map("disbursed_at") @db.Timestamptz()

  loan Loan @relation(fields: [loanId], references: [loanId])

  @@map("loan_disbursements")
}

model RepaymentSchedule {
  scheduleId        String   @id @default(uuid()) @map("schedule_id") @db.Uuid
  loanId            String   @map("loan_id") @db.Uuid
  installmentNumber Int      @map("installment_number")
  dueDate           DateTime @map("due_date") @db.Date
  expectedAmount    Decimal  @map("expected_amount") @db.Decimal(12, 2)
  status            String   @default("pending") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()

  loan       Loan        @relation(fields: [loanId], references: [loanId])
  repayments Repayment[]

  @@map("repayment_schedules")
}

model Repayment {
  repaymentId          String   @id @default(uuid()) @map("repayment_id") @db.Uuid
  scheduleId           String   @map("schedule_id") @db.Uuid
  amountPaid           Decimal  @map("amount_paid") @db.Decimal(12, 2)
  paymentMethod        String?  @map("payment_method") @db.VarChar(50)
  transactionReference String?  @map("transaction_reference") @db.VarChar(100)
  status               String   @default("completed") @db.VarChar(20)
  paidAt               DateTime @default(now()) @map("paid_at") @db.Timestamptz()

  schedule RepaymentSchedule @relation(fields: [scheduleId], references: [scheduleId])

  @@map("repayments")
}

model PartnerDecision {
  decisionId    String   @id @default(uuid()) @map("decision_id") @db.Uuid
  applicationId String   @map("application_id") @db.Uuid
  partnerId     String   @map("partner_id") @db.Uuid
  decision      String   @db.VarChar(20)
  reason        String?
  decidedBy     String?  @map("decided_by") @db.Uuid
  decidedAt     DateTime @default(now()) @map("decided_at") @db.Timestamptz()

  application LoanApplication @relation(fields: [applicationId], references: [applicationId])
  partner     FundingPartner  @relation(fields: [partnerId], references: [partnerId])
  decidedByUser User?         @relation(fields: [decidedBy], references: [userId])

  @@map("partner_decisions")
}

model FraudFlag {
  flagId          String    @id @default(uuid()) @map("flag_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  flagType        String    @map("flag_type") @db.VarChar(100)
  severity        String    @db.VarChar(20)
  description     String?
  status          String    @default("open") @db.VarChar(20)
  reviewedBy      String?   @map("reviewed_by") @db.Uuid
  resolutionNotes String?   @map("resolution_notes")
  flaggedAt       DateTime  @default(now()) @map("flagged_at") @db.Timestamptz()
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz()

  user     User  @relation("UserFraudFlags", fields: [userId], references: [userId])
  reviewer User? @relation("ReviewerFraudFlags", fields: [reviewedBy], references: [userId])

  @@map("fraud_flags")
}

model AuditLog {
  logId       String   @id @default(uuid()) @map("log_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [userId])

  @@map("audit_logs")
}

model Notification {
  notificationId String    @id @default(uuid()) @map("notification_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  channel        String    @db.VarChar(20)
  type           String    @db.VarChar(100)
  title          String    @db.VarChar(255)
  body           String
  isRead         Boolean   @default(false) @map("is_read")
  deliveryStatus String    @default("pending") @map("delivery_status") @db.VarChar(20)
  retryCount     Int       @default(0) @map("retry_count")
  sentAt         DateTime? @map("sent_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [userId])

  @@map("notifications")
}
