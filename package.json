{
  "name": "shohojrin-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=@shohojrin/frontend",
    "dev:backend": "npm run dev --workspace=@shohojrin/backend",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspace=@shohojrin/frontend",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.7.3"
  }
}
